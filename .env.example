# Get these from https://my.telegram.org -> "API development tools"
TG_API_ID=
TG_API_HASH=

# Password for the web interface (required). Choose a strong one.
APP_PASSWORD=

# Folder on this computer where downloaded files will be stored (a large drive).
# Windows example: STORAGE_HOST_PATH=D:/TGLibrary
STORAGE_HOST_PATH=./storage

# Paths inside the container; normally leave as they are.
DATA_DIR=/data
STORAGE_DIR=/storage
PORT=8000
